    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
